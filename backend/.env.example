DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio
NODE_ENV=development
API_PORT=3001
JWT_SECRET=your-jwt-secret-key-change-in-production
CORS_ORIGIN=http://localhost:3000
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,mp4,mov,webm,pdf,doc,docx

# Email Configuration (optional - for notifications)
# Using Resend (https://resend.com)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yoursite.com

# Admin email for moderation notifications
ADMIN_EMAIL=KaylasSideQuests@pm.me

# Site URL (for email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
