{
  "name": "personal-portfolio",
  "version": "1.0.0",
  "description": "Personal Life Portfolio - Full Stack Application",
  "private": true,
  "scripts": {
    "deploy": "node deploy.js",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd backend && npm run dev",
    "dev:web": "cd frontend && npm run dev",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "build:shared": "cd packages/shared && npm run build",
    "build:api": "cd backend && npm run build",
    "build:web": "cd frontend && npm run build",
    "deploy:local": "powershell -ExecutionPolicy Bypass -File ./deploy/scripts/deploy-local.ps1",
    "deploy:local:fresh": "powershell -ExecutionPolicy Bypass -File ./deploy/scripts/deploy-local.ps1 -Fresh -Seed",
    "deploy:local:logs": "powershell -ExecutionPolicy Bypass -File ./deploy/scripts/deploy-local.ps1 -Logs",
    "health": "powershell -ExecutionPolicy Bypass -File ./deploy/scripts/health-check.ps1 -Environment local",
    "health:flyio": "powershell -ExecutionPolicy Bypass -File ./deploy/scripts/health-check.ps1 -Environment flyio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v",
    "cleanup:legacy": "powershell -ExecutionPolicy Bypass -File ./deploy/scripts/remove-legacy-files.ps1",
    "cleanup:legacy:force": "powershell -ExecutionPolicy Bypass -File ./deploy/scripts/remove-legacy-files.ps1 -DryRun:$false -Force",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "keywords": [
    "portfolio",
    "blog",
    "timeline",
    "full-stack"
  ],
  "author": "Kayla Lambert",
  "license": "MIT"
}
